# Variáveis de ambiente do ERP Veterinário.
# Copie para .env (`cp .env.example .env`) e ajuste os valores.
# O arquivo .env não deve ser commitado.

# Conexão usada pelo Prisma Client (host e porta do PostgreSQL local).
# O usuário, a senha e o nome do banco precisam ser os mesmos definidos em
# POSTGRES_* abaixo.
DATABASE_URL="postgresql://user:password@localhost:5432/erp_veterinario?schema=public"

# Credenciais do container PostgreSQL (docker compose).
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=erp_veterinario
POSTGRES_PORT=5432

# Segredo usado para assinar os access tokens JWT.
# Gere um valor aleatório próprio, por exemplo: openssl rand -hex 32
JWT_SECRET=troque-este-valor

# Tempo de vida do access token, em segundos (900 = 15 minutos).
JWT_EXPIRATION=900

# Tempo de vida do token intermediário de seleção de tenant, em segundos.
TENANT_SELECTION_EXPIRATION_SECONDS=300

# Tempo de vida do refresh token, em dias.
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Porta HTTP do backend.
PORT=3000
