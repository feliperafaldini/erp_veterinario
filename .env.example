# Exemplo de variáveis de ambiente. Copie para .env e ajuste:
#   cp .env.example .env
#
# O arquivo .env não é versionado (.gitignore). Nunca commite segredos reais.

# --- Banco de dados ---------------------------------------------------------
# Usado pela aplicação e pela suíte de testes.
DATABASE_URL="postgresql://user:password@localhost:5432/erp_veterinario?schema=public"

# Credenciais do PostgreSQL criado pelo docker-compose.
# Mantenha POSTGRES_* coerentes com o usuário/senha/banco do DATABASE_URL.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=erp_veterinario
# POSTGRES_PORT=5432

# --- Autenticação -----------------------------------------------------------
# Segredo de assinatura do JWT. Obrigatório (o compose aborta sem ele).
# Em produção gere um valor aleatório longo e mantenha fora do Git.
JWT_SECRET=change-me-in-local-development
# Duração do access token em segundos (900 = 15 minutos).
JWT_EXPIRATION=900
# Duração do refresh token em dias.
REFRESH_TOKEN_EXPIRATION_DAYS=7

# --- Servidor ---------------------------------------------------------------
# PORT=3000

# NODE_ENV=production
# Defina apenas atrás de TLS: em produção o cookie de refresh é marcado como
# Secure e deixa de ser enviado por http://localhost.
