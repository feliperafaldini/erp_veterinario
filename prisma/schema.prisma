generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String               @id @default(uuid()) @db.Uuid
  name                         String
  email                        String               @unique
  passwordHash                 String
  phone                        String?
  isActive                     Boolean              @default(true)
  isPlatformAdmin              Boolean              @default(false)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  registeredAnimalAllergies    AnimalAllergy[]
  registeredAnimalMedications  AnimalMedication[]
  registeredAnimalVaccinations AnimalVaccination[]
  animalWeightRecords          AnimalWeightRecord[]
  sessions                     Session[]
  userTenants                  UserTenant[]
  veterinarian                 Veterinarian?

  @@map("User")
}

model Tenant {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  cpf                    String?                 @unique
  cnpj                   String?                 @unique
  addressLine1           String
  addressLine2           String?
  city                   String
  state                  String
  zipCode                String
  phone                  String?
  email                  String?
  logoUrl                String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  animalAllergies        AnimalAllergy[]
  animalMedications      AnimalMedication[]
  animalTutors           AnimalTutor[]
  animalVaccinations     AnimalVaccination[]
  animalWeightRecords    AnimalWeightRecord[]
  sessions               Session[]
  tenantAnimals          TenantAnimal[]
  tenantVeterinarians    TenantVeterinarian[]
  tutors                 Tutor[]
  tutorAddresses         TutorAddress[]
  tutorEmergencyContacts TutorEmergencyContact[]
  tutorPhones            TutorPhone[]
  userTenants            UserTenant[]

  @@map("Tenant")
}

model UserTenant {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  tenantId        String           @db.Uuid
  status          UserTenantStatus @default(PENDING)
  invitedAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userTenantRoles UserTenantRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("UserTenant")
}

model UserTenantRole {
  id           String     @id @default(uuid()) @db.Uuid
  userTenantId String     @db.Uuid
  roleId       String     @db.Uuid
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userTenant   UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)

  @@unique([userTenantId, roleId])
  @@index([roleId])
  @@map("UserTenantRole")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  tenantId         String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastAccessAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([refreshTokenHash])
  @@map("Session")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  userTenantRoles UserTenantRole[]

  @@map("Role")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  resource        String
  action          String
  description     String?
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("Permission")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("RolePermission")
}

model Veterinarian {
  id                      String                  @id @default(uuid()) @db.Uuid
  name                    String
  crmv                    String                  @unique
  bio                     String?
  userId                  String?                 @unique @db.Uuid
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  tenantVeterinarians     TenantVeterinarian[]
  user                    User?                   @relation(fields: [userId], references: [id])
  veterinarianSpecialties VeterinarianSpecialty[]

  @@map("Veterinarian")
}

model Specialty {
  id                      String                  @id @default(uuid()) @db.Uuid
  name                    String                  @unique
  description             String?
  createdAt               DateTime                @default(now())
  veterinarianSpecialties VeterinarianSpecialty[]

  @@map("Specialty")
}

model VeterinarianSpecialty {
  veterinarianId String       @db.Uuid
  specialtyId    String       @db.Uuid
  specialty      Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  veterinarian   Veterinarian @relation(fields: [veterinarianId], references: [id], onDelete: Cascade)

  @@id([veterinarianId, specialtyId])
  @@map("VeterinarianSpecialty")
}

model TenantVeterinarian {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  veterinarianId String       @db.Uuid
  joinedAt       DateTime     @default(now())
  isActive       Boolean      @default(true)
  schedule       Json?
  room           String?
  function       String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  veterinarian   Veterinarian @relation(fields: [veterinarianId], references: [id], onDelete: Cascade)

  @@unique([tenantId, veterinarianId])
  @@index([veterinarianId])
  @@map("TenantVeterinarian")
}

model TutorIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  documentType   DocumentType
  documentNumber String
  createdAt      DateTime     @default(now())
  tutors         Tutor[]

  @@unique([documentType, documentNumber])
  @@map("TutorIdentity")
}

model Tutor {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @db.Uuid
  tutorIdentityId   String                  @db.Uuid
  email             String?
  additionalInfo    String?
  isActive          Boolean                 @default(true)
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  animalTutors      AnimalTutor[]
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutorIdentity     TutorIdentity           @relation(fields: [tutorIdentityId], references: [id], onDelete: Cascade)
  addresses         TutorAddress[]
  emergencyContacts TutorEmergencyContact[]
  phones            TutorPhone[]

  @@unique([tenantId, tutorIdentityId])
  @@unique([tenantId, email])
  @@index([tutorIdentityId])
  @@map("Tutor")
}

model TutorPhone {
  id        String   @id @default(uuid()) @db.Uuid
  tutorId   String   @db.Uuid
  tenantId  String   @db.Uuid
  number    String
  label     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tutorId, number])
  @@index([tutorId])
  @@map("TutorPhone")
}

model TutorAddress {
  id           String   @id @default(uuid()) @db.Uuid
  tutorId      String   @db.Uuid
  tenantId     String   @db.Uuid
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zipCode      String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor        Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("TutorAddress")
}

model TutorEmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  tutorId      String   @db.Uuid
  tenantId     String   @db.Uuid
  name         String
  phone        String
  relationship String?
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor        Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("TutorEmergencyContact")
}

model Animal {
  id                 String               @id @default(uuid()) @db.Uuid
  internalCode       String               @unique
  name               String?
  speciesId          String               @db.Uuid
  breedId            String               @db.Uuid
  sex                AnimalSex
  isCastrated        Boolean              @default(false)
  castrationDate     DateTime?
  dateOfBirth        DateTime?
  approximateAge     String?
  microchip          String?              @unique
  photoUrl           String?
  color              String?
  size               AnimalSize?
  dateOfDeath        DateTime?
  status             AnimalStatus         @default(ACTIVE)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  breed              Breed                @relation(fields: [breedId], references: [id])
  species            Species              @relation(fields: [speciesId], references: [id])
  animalAllergies    AnimalAllergy[]
  animalMedications  AnimalMedication[]
  animalTutors       AnimalTutor[]
  animalVaccinations AnimalVaccination[]
  weightRecords      AnimalWeightRecord[]
  tenantAnimals      TenantAnimal[]

  @@index([speciesId])
  @@index([breedId])
  @@map("Animal")
}

model Species {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  scientificName String?
  createdAt      DateTime @default(now())
  animals        Animal[]
  breeds         Breed[]

  @@map("Species")
}

model Breed {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  speciesId String   @db.Uuid
  createdAt DateTime @default(now())
  animals   Animal[]
  species   Species  @relation(fields: [speciesId], references: [id])

  @@unique([speciesId, name])
  @@index([speciesId])
  @@map("Breed")
}

model TenantAnimal {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  animalId  String             @db.Uuid
  status    TenantAnimalStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  animal    Animal             @relation(fields: [animalId], references: [id])
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, animalId])
  @@index([animalId])
  @@map("TenantAnimal")
}

model AnimalTutor {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  animalId  String    @db.Uuid
  tutorId   String    @db.Uuid
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  isActive  Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  animal    Animal    @relation(fields: [animalId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  tutor     Tutor     @relation(fields: [tutorId], references: [id])

  @@index([tenantId, animalId, tutorId])
  @@index([animalId])
  @@index([tutorId])
  @@map("AnimalTutor")
}

model AnimalWeightRecord {
  id         String   @id @default(uuid()) @db.Uuid
  animalId   String   @db.Uuid
  tenantId   String   @db.Uuid
  weight     Decimal  @db.Decimal(7, 2)
  recordedAt DateTime @default(now())
  recordedBy String?  @db.Uuid
  notes      String?
  createdAt  DateTime @default(now())
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  recorder   User?    @relation(fields: [recordedBy], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([recordedBy])
  @@map("AnimalWeightRecord")
}

model Allergy {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @unique
  description     String?
  createdAt       DateTime        @default(now())
  animalAllergies AnimalAllergy[]

  @@map("Allergy")
}

model AnimalAllergy {
  id                   String   @id @default(uuid()) @db.Uuid
  animalId             String   @db.Uuid
  allergyId            String   @db.Uuid
  severity             String?
  description          String?
  notes                String?
  registeredAt         DateTime @default(now())
  registeredByTenantId String   @db.Uuid
  registeredByUserId   String?  @db.Uuid
  createdAt            DateTime @default(now())
  allergy              Allergy  @relation(fields: [allergyId], references: [id], onDelete: Cascade)
  animal               Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  registeredByTenant   Tenant   @relation(fields: [registeredByTenantId], references: [id], onDelete: Cascade)
  registeredByUser     User?    @relation(fields: [registeredByUserId], references: [id])

  @@unique([animalId, allergyId])
  @@index([allergyId])
  @@index([registeredByTenantId])
  @@index([registeredByUserId])
  @@map("AnimalAllergy")
}

model Medication {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @unique
  description       String?
  createdAt         DateTime           @default(now())
  animalMedications AnimalMedication[]

  @@map("Medication")
}

model AnimalMedication {
  id                   String     @id @default(uuid()) @db.Uuid
  animalId             String     @db.Uuid
  medicationId         String     @db.Uuid
  dosage               String
  frequency            String
  route                String?
  startDate            DateTime
  endDate              DateTime?
  notes                String?
  registeredAt         DateTime   @default(now())
  registeredByTenantId String     @db.Uuid
  registeredByUserId   String?    @db.Uuid
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  animal               Animal     @relation(fields: [animalId], references: [id], onDelete: Cascade)
  medication           Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  registeredByTenant   Tenant     @relation(fields: [registeredByTenantId], references: [id], onDelete: Cascade)
  registeredByUser     User?      @relation(fields: [registeredByUserId], references: [id])

  @@index([medicationId])
  @@index([registeredByTenantId])
  @@index([registeredByUserId])
  @@map("AnimalMedication")
}

model Vaccine {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @unique
  description        String?
  createdAt          DateTime            @default(now())
  animalVaccinations AnimalVaccination[]

  @@map("Vaccine")
}

model AnimalVaccination {
  id                   String    @id @default(uuid()) @db.Uuid
  animalId             String    @db.Uuid
  vaccineId            String    @db.Uuid
  applicationDate      DateTime
  lotNumber            String?
  nextDoseDate         DateTime?
  notes                String?
  registeredAt         DateTime  @default(now())
  registeredByTenantId String    @db.Uuid
  registeredByUserId   String?   @db.Uuid
  createdAt            DateTime  @default(now())
  animal               Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  registeredByTenant   Tenant    @relation(fields: [registeredByTenantId], references: [id], onDelete: Cascade)
  registeredByUser     User?     @relation(fields: [registeredByUserId], references: [id])
  vaccine              Vaccine   @relation(fields: [vaccineId], references: [id], onDelete: Cascade)

  @@unique([animalId, vaccineId, applicationDate])
  @@index([vaccineId])
  @@index([registeredByTenantId])
  @@index([registeredByUserId])
  @@map("AnimalVaccination")
}

enum UserTenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum DocumentType {
  CPF
  CNPJ
}

enum AnimalSex {
  MALE
  FEMALE
  UNKNOWN
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
}

enum AnimalStatus {
  ACTIVE
  DECEASED
  INACTIVE
}

enum TenantAnimalStatus {
  ACTIVE
  INACTIVE
}
